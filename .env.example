# ── Tailscale ────────────────────────────────────────────────
# 認証キー。https://login.tailscale.com/admin/settings/keys で発行。
# Reusable + Ephemeral を推奨。
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# ── Cloudflare Tunnel ────────────────────────────────────────
# Zero Trust > Networks > Tunnels でトンネルを作成して得られるトークン。
# Public Hostname のサービスは Type=「Unix Socket」, URL=/run/noticord/ingest.sock。
TUNNEL_TOKEN=eyJhxxxxxxxxxxxx

# cloudflared で割り当てた公開URL(末尾スラッシュ不要)。
# 管理画面に表示する Webhook URL のベースに使う。
NOTICORD_PUBLIC_URL=https://noticord.example.com

# ── noticord ────────────────────────────────────────────────────
# 管理画面のログインパスワード。空にすると認証なし(Tailscale 網のみで保護)。
NOTICORD_ADMIN_PASSWORD=change-me

# VAPID subject(プッシュサービスへの連絡先)。
NOTICORD_VAPID_SUBJECT=mailto:you@example.com

# デバッグログ。1 にすると受信内容と各購読への送信結果
# (送信先ホスト apple/fcm + プッシュサービスの HTTP ステータス)をログ出力する。
# 通常運用では空にしておく(購読情報の露出を避けるため)。
NOTICORD_DEBUG=
